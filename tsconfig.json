{
  "compilerOptions": {
    //Decorator config
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler", // Changed from "node" to "bundler"
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
    
  },
  

  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "app/scripts/executable.mts"],
  "exclude": ["node_modules"]
}